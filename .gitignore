# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# IDE / Editor Files
.vscode/
.idea/
*.swp
*.swo

# Large Datasets (Do not commit huge datasets to GitHub)
dataset/train/*
dataset/validation/*
dataset/test/*
!dataset/train/.gitkeep
!dataset/validation/.gitkeep
!dataset/test/.gitkeep

# Temporary Uploads
static/uploads/*
!static/uploads/.gitkeep

# Local SQLite databases
database/*.db

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Logs & Temporary Scratch Files
*.log
scratch/
